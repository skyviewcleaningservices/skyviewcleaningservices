generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  username          String             @unique
  password          String
  email             String?            @unique
  phone             String?            @unique
  role              UserRole           @default(ADMIN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  passwordResetOtps PasswordResetOtp[]
}

model PasswordResetOtp {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Booking {
  id                  Int           @id @default(autoincrement())
  name                String
  email               String?
  phone               String
  address             String
  serviceType         String
  frequency           String
  preferredDate       DateTime
  preferredTime       String
  flatType            FlatType
  additionalServices  String
  specialInstructions String?
  status              BookingStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  statusReason        String?
  paymentAmount       Float?
  paymentType         PaymentType?
  remarks             String?
  area                String?
}

model PriceRate {
  id          Int      @id @default(autoincrement())
  flatType    FlatType
  serviceType String
  price       Float?
  updatedAt   DateTime @updatedAt

  @@unique([flatType, serviceType])
}

model AddOnPrice {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Float?
  updatedAt DateTime @updatedAt
}

model Employee {
  id                    Int            @id @default(autoincrement())
  name                  String
  phone                 String
  email                 String?
  address               String?
  role                  String?
  aadharNumber          String?
  panNumber             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  joiningDate           DateTime?
  salaryAmount          Float?
  salaryType            SalaryType?
  status                EmployeeStatus @default(ACTIVE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  attendance            Attendance[]
  salaryAdvances        SalaryAdvance[]
}

// One row per day an employee worked — a day with no row means they didn't
// work it. Backs both the attendance checkboxes and the monthly salary calc.
model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
}

// One row per employee per month — the total advance taken that month,
// subtracted from calculated salary to get total pay.
model SalaryAdvance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String // "YYYY-MM"
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, month])
}

model Expense {
  id          Int          @id @default(autoincrement())
  description String
  category    String?
  amount      Float
  date        DateTime
  paymentType PaymentType?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// A quotation (pre-sale estimate) or invoice (post-sale bill) generated for a
// customer — number is sequential per type (QTN-0001, INV-0001, ...).
model Quotation {
  id              Int             @id @default(autoincrement())
  number          String          @unique
  type            DocumentType    @default(QUOTATION)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  gstNumber       String?
  applyGst        Boolean         @default(false)
  gstPercent      Float?
  date            DateTime        @default(now())
  notes           String?
  subtotal        Float
  gstAmount       Float           @default(0)
  total           Float
  items           QuotationItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Float      @default(1)
  rate        Float
  amount      Float
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentType {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum FlatType {
  ONE_BHK
  TWO_BHK
  THREE_BHK
  FOUR_BHK
  STUDIO
  PENTHOUSE
}

enum UserRole {
  ADMIN
  STAFF
  MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SalaryType {
  MONTHLY
  DAILY
  PER_JOB
}

enum DocumentType {
  QUOTATION
  INVOICE
}